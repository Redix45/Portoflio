---
import BaseLayout from '../layouts/BaseLayout.astro';

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "ImageGallery",
    "name": "Zielony Parapet - Sesja Próbna",
    "description": "Galeria zdjęć produktowych - Zielony Parapet",
    "url": "https://jankobus.com/zielony-parapet/",
    "creator": {
      "@type": "Person",
      "name": "Jan Kobus"
    },
    "datePublished": "2026-05-24"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [{
      "@type": "ListItem",
      "position": 1,
      "name": "Strona główna",
      "item": "https://jankobus.com/"
    },{
      "@type": "ListItem",
      "position": 2,
      "name": "Fotografia Eventowa",
      "item": "https://jankobus.com/events/"
    },{
      "@type": "ListItem",
      "position": 3,
      "name": "Zielony Parapet - Sesja Próbna",
      "item": "https://jankobus.com/zielony-parapet/"
    }]
  }
];
---

<BaseLayout
    title="Zielony Parapet - Sesja Próbna | Jan Kobus Fotografia"
    description="Galeria zdjęć produktowych Zielony Parapet. Profesjonalna fotografia produktowa - Jan Kobus."
    keywords="Zielony Parapet, fotografia produktowa, sesja próbna, Jan Kobus, rośliny"
    canonical="https://jankobus.com/zielony-parapet/"
    ogType="article"
    ogImage="https://jankobus.com/photos/zielony_parapet/sesja2/Zielony%20Parapet%20v2-557.jpg"
    twitterCard="summary_large_image"
    structuredData={structuredData}
    preloadImages={["/photos/zielony_parapet/sesja2/Zielony%20Parapet%20v2-557.jpg"]}
>

    <nav>
        <div class="nav-left">
            <a href="/#work">Prace</a>
            <a href="/o-mnie">O mnie</a>
            <a href="/kontakt">Kontakt</a>
        </div>
        <div class="nav-center">
            <a href="/">Jan Kobus</a>
        </div>
        <div class="nav-right">
            <a href="https://www.facebook.com/profile.php?id=61587671346611" target="_blank"><i class="fab fa-facebook-f"></i></a>
            <a href="https://www.instagram.com/redix.45/" target="_blank"><i class="fab fa-instagram"></i></a>
        </div>
        <button class="nav-hamburger" aria-label="Menu" aria-expanded="false"><span></span><span></span><span></span></button>
    </nav>

    <header class="project-header">
        <h1>Zielony Parapet</h1>
        <p class="project-subtitle">Sesja Próbna</p>
    </header>

    <h2 class="session-heading">Sesja II</h2>
    <section class="masonry-gallery" id="galeria-sesja2"></section>

    <h2 class="session-heading">Sesja I</h2>
    <section class="masonry-gallery" id="galeria-sesja1"></section>

    <div class="see-more-container">
        <h2 class="see-more-title">Zobacz więcej albumów</h2>
        <div class="related-albums">
            <div class="gallery-container">
                <div class="gallery-item">
                    <a href="/operetka">
                        <picture>
                            <source srcset="/photos/operetka/foto%20(2).webp" type="image/webp">
                            <source srcset="/photos/operetka/foto%20(2).jpg">
                            <img src="/photos/operetka/foto%20(2).jpg" alt="Fotografia eventowa Lubliniec - koncert Cabaret w Operetce" loading="eager" decoding="async">
                        </picture>
                    </a>
                </div>
                <div class="caption-box">
                    <div class="caption-title">Cabaret w Operetce</div>
                    <div class="caption-year">2025</div>
                </div>
            </div>
            <div class="gallery-container">
                <div class="gallery-item">
                    <a href="/koszecin-wosp">
                        <picture>
                            <source srcset="/photos/Koszęcin%20WOŚP%202026/DSC03294.webp" type="image/webp">
                            <img src="/photos/Koszęcin%20WOŚP%202026/DSC03294.jpg" alt="Fotografia eventowa Koszęcin - WOŚP 2026" loading="eager" decoding="async">
                        </picture>
                    </a>
                </div>
                <div class="caption-box">
                    <div class="caption-title">Koszęcin WOŚP 2026</div>
                    <div class="caption-year">2026</div>
                </div>
            </div>
        </div>
    </div>

    <footer>
        <div class="footer-content">
            <p>&copy; 2026 Jan Kobus. Wszelkie prawa zastrzeżone.</p>
            <div class="footer-socials">
                <a href="https://www.facebook.com/profile.php?id=61587671346611" target="_blank"><i class="fab fa-facebook-f"></i></a>
                <a href="https://www.instagram.com/redix.45/" target="_blank"><i class="fab fa-instagram"></i></a>
            </div>
        </div>
    </footer>

    <script is:inline>
        // Sesja II - Zielony Parapet v2
        const sesja2Images = [
            'Zielony Parapet v2-557.jpg', 'Zielony Parapet v2-634.jpg', 'Zielony Parapet v2-648.jpg',
            'Zielony Parapet v2-655.jpg', 'Zielony Parapet v2-658.jpg', 'Zielony Parapet v2-680.jpg',
            'Zielony Parapet v2-710.jpg', 'Zielony Parapet v2-744.jpg', 'Zielony Parapet v2-755.jpg',
            'Zielony Parapet v2-762.jpg', 'Zielony Parapet v2-764.jpg', 'Zielony Parapet v2-769.jpg',
            'Zielony Parapet v2-797.jpg', 'Zielony Parapet v2-812.jpg', 'Zielony Parapet v2-831.jpg',
            'Zielony Parapet v2-834.jpg', 'Zielony Parapet v2-860.jpg', 'Zielony Parapet v2-873.jpg',
            'Zielony Parapet v2-880.jpg', 'Zielony Parapet v2-885.jpg', 'Zielony Parapet v2-888.jpg',
            'Zielony Parapet v2-906.jpg', 'Zielony Parapet v2-920.jpg', 'Zielony Parapet v2-930.jpg'
        ];

        // Sesja I - Studio Session (wszystkie grupy)
        const sesja1Groups = [
            {
                folder: '/photos/zielony_parapet/sesja1/Doniczka%201/',
                images: [
                    'Studio Session-303.jpg', 'Studio Session-308.jpg', 'Studio Session-315.jpg',
                    'Studio Session-323.jpg', 'Studio Session-347.jpg', 'Studio Session-476.jpg',
                    'Studio Session-531.jpg'
                ]
            },
            {
                folder: '/photos/zielony_parapet/sesja1/Doniczka%202/',
                images: [
                    'Studio Session-349.jpg', 'Studio Session-365.jpg', 'Studio Session-372.jpg',
                    'Studio Session-373.jpg', 'Studio Session-485.jpg', 'Studio Session-527.jpg'
                ]
            },
            {
                folder: '/photos/zielony_parapet/sesja1/Ro%C5%9Blina%201/',
                images: [
                    'Studio Session-095.jpg', 'Studio Session-254.jpg', 'Studio Session-255.jpg',
                    'Studio Session-355.jpg', 'Studio Session-413.jpg', 'Studio Session-443.jpg'
                ]
            },
            {
                folder: '/photos/zielony_parapet/sesja1/Ro%C5%9Blina%202/',
                images: [
                    'Studio Session-104.jpg', 'Studio Session-106.jpg', 'Studio Session-138.jpg',
                    'Studio Session-154.jpg', 'Studio Session-170.jpg', 'Studio Session-177.jpg',
                    'Studio Session-449.jpg'
                ]
            },
            {
                folder: '/photos/zielony_parapet/sesja1/Ro%C5%9Blina%203/',
                images: [
                    'Studio Session-189.jpg', 'Studio Session-219.jpg', 'Studio Session-265.jpg',
                    'Studio Session-439.jpg', 'Studio Session-517.jpg'
                ]
            }
        ];

        function buildMasonryItem(folder, filename, index, totalCount, allImages, globalOffset) {
            const div = document.createElement('div');
            div.className = 'masonry-item';

            const picture = document.createElement('picture');
            const imgEl = document.createElement('img');

            imgEl.src = folder + encodeURIComponent(filename).replace(/%20/g, '%20');
            imgEl.alt = 'Fotografia produktowa - Zielony Parapet';
            imgEl.loading = index < 3 ? 'eager' : 'lazy';
            if (index < 2) imgEl.fetchPriority = 'high';
            imgEl.decoding = 'async';
            imgEl.style.width = '100%';
            imgEl.style.height = 'auto';
            imgEl.style.display = 'block';

            imgEl.onclick = () => {
                openLightbox(folder, '', globalOffset + index + 1, allImages.length, '.jpg', 0, allImages);
            };

            picture.appendChild(imgEl);
            div.appendChild(picture);
            return div;
        }

        // Buduj galerię Sesja II
        const container2 = document.getElementById('galeria-sesja2');
        const folder2 = '/photos/zielony_parapet/sesja2/';
        sesja2Images.forEach((img, i) => {
            const div = document.createElement('div');
            div.className = 'masonry-item';
            const imgEl = document.createElement('img');
            imgEl.src = folder2 + img;
            imgEl.alt = 'Fotografia produktowa - Zielony Parapet';
            imgEl.loading = i < 3 ? 'eager' : 'lazy';
            if (i < 2) imgEl.fetchPriority = 'high';
            imgEl.decoding = 'async';
            imgEl.style.width = '100%';
            imgEl.style.height = 'auto';
            imgEl.style.display = 'block';
            imgEl.onclick = () => {
                openLightbox(folder2, '', i + 1, sesja2Images.length, '.jpg', 0, sesja2Images);
            };
            div.appendChild(imgEl);
            container2.appendChild(div);
        });

        // Buduj galerię Sesja I (wszystkie grupy po kolei)
        const container1 = document.getElementById('galeria-sesja1');
        let allSesja1 = [];
        sesja1Groups.forEach(g => g.images.forEach(img => allSesja1.push({ folder: g.folder, img })));

        allSesja1.forEach(({ folder, img }, i) => {
            const div = document.createElement('div');
            div.className = 'masonry-item';
            const imgEl = document.createElement('img');
            imgEl.src = folder + img;
            imgEl.alt = 'Fotografia produktowa - Zielony Parapet';
            imgEl.loading = i < 3 ? 'eager' : 'lazy';
            imgEl.decoding = 'async';
            imgEl.style.width = '100%';
            imgEl.style.height = 'auto';
            imgEl.style.display = 'block';
            imgEl.onclick = () => {
                openLightbox(folder, '', i + 1, allSesja1.length, '.jpg', 0, allSesja1.map(x => x.img));
            };
            div.appendChild(imgEl);
            container1.appendChild(div);
        });
    </script>

    <style>
        .session-heading {
            text-align: center;
            font-size: 1.4rem;
            font-weight: 400;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: #aaa;
            margin: 3rem 0 1rem;
        }
        .project-subtitle {
            text-align: center;
            color: #aaa;
            font-size: 1rem;
            letter-spacing: 0.1em;
            margin-top: 0.5rem;
        }
    </style>

</BaseLayout>
