---
import ReelLayout from '../layouts/ReelLayout.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jan Kobus',
  jobTitle: 'Montażysta wideo',
  description: 'Montaż krótkich pionowych filmów: Reels, TikTok, YouTube Shorts. Lubliniec.',
  url: 'https://jankobus.com/o-mnie/',
  sameAs: ['https://www.facebook.com/profile.php?id=61587671346611', 'https://www.instagram.com/redix.45/']
};
---

<ReelLayout
    title="O mnie | Jan Kobus – montaż rolek, Lubliniec"
    description="Jan Kobus z Lublińca. Montuję krótkie pionowe filmy na Reels, TikToka i Shorts. Wcześniej fotografowałem eventy i nieruchomości."
    canonical="https://jankobus.com/o-mnie/"
    ogType="profile"
    structuredData={structuredData}
    active="o-mnie"
>
    <section class="page-head" data-clip="O mnie" data-track="t1">
        <p class="eyebrow"><span class="tc-chip">00:00:00:00</span> O mnie</p>
        <h1 class="display">Cześć, jestem Janek.</h1>
    </section>

    <section class="about" data-clip="Historia" data-track="v1">
        <figure class="about-photo reveal">
            <img src="/about-photo.jpg" alt="Jan Kobus" width="800" height="1000" decoding="async">
        </figure>
        <div class="about-text reveal">
            <p class="lead">
                Jestem z Lublińca i montuję krótkie pionowe filmy: rolki na Instagrama,
                TikToka i YouTube Shorts.
            </p>
            <p>
                Zaczynałem od fotografii: koncerty, festiwale, lokalne wydarzenia i nieruchomości.
                Z czasem zauważyłem, że ludzie zatrzymują się przy rolce dłużej niż przy zdjęciu,
                a dobrze zmontowane 30 sekund potrafi opowiedzieć cały wieczór.
                Dlatego dziś skupiam się na montażu.
            </p>
            <p>
                Z fotografii zostało mi oko do kadru i światła. W montażu dochodzi rytm:
                tniesz pod muzykę, pilnujesz, żeby pierwsza sekunda zatrzymała kciuk,
                a napis był czytelny na małym ekranie. Każdą rolkę oglądam na telefonie,
                zanim ją wyślę, bo tam będzie oglądana.
            </p>

            <h2>W skrócie</h2>
            <ul class="kit">
                <li><span>Platformy</span><span>Instagram Reels, TikTok, YouTube Shorts</span></li>
                <li><span>Formaty</span><span>9:16, na życzenie 1:1 i 16:9</span></li>
                <li><span>Teren</span><span>Lubliniec i okolice na miejscu, reszta Polski zdalnie</span></li>
                <li><span>Kontakt</span><span><a href="/kontakt/">formularz</a> lub <a href="https://www.instagram.com/redix.45/" target="_blank" rel="noopener noreferrer">Instagram</a></span></li>
            </ul>
        </div>
    </section>

    <section class="end" data-clip="Kontakt" data-track="v2">
        <h2 class="display display-end">Zróbmy pierwszą rolkę.</h2>
        <a href="/kontakt/" class="btn btn-primary">Wyślij materiał</a>
    </section>
</ReelLayout>
