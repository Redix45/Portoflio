---
import Layout from '../layouts/Layout.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Kontakt – wizytówki Google, Jan Kobus',
  url: 'https://jankobus.com/kontakt/',
  mainEntity: { '@id': 'https://jankobus.com' }
};
---

<Layout
    title="Kontakt | Jan Kobus – wizytówki Google, Lubliniec"
    description="Zadzwoń (732 800 250) albo napisz w sprawie wizytówki Google, pozycjonowania lokalnego lub darmowego audytu widoczności. Lubliniec i okolice."
    canonical="https://jankobus.com/kontakt/"
    structuredData={structuredData}
    active="kontakt"
>
    <section class="page-head">
        <p class="eyebrow">Kontakt</p>
        <h1 class="display">Napisz do mnie.</h1>
        <p class="lead">Pytanie o wizytówkę Google, wycenę albo współpracę? Odpiszę w ciągu 2 dni roboczych.</p>
        <p class="contact-phone">Wolisz zadzwonić? <a class="phone" href="tel:+48732800250">732 800 250</a></p>
    </section>

    <section class="contact">
        <form class="form" action="https://formspree.io/f/mbdrgppo" method="POST">
            <input type="hidden" name="_subject" value="Nowe zapytanie z jankobus.com">
            <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
            <div class="field-row">
                <div class="field">
                    <label for="name">Imię</label>
                    <input type="text" id="name" name="name" autocomplete="name" required>
                </div>
                <div class="field">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" autocomplete="email" required>
                </div>
            </div>
            <div class="field-row">
                <div class="field">
                    <label for="type">Temat</label>
                    <select id="type" name="temat">
                        <option value="audyt">Darmowy audyt widoczności</option>
                        <option value="wdrozenie">Wdrożenie wizytówki Google</option>
                        <option value="opieka">Stała opieka nad wizytówką</option>
                        <option value="inne">Inne</option>
                    </select>
                </div>
                <div class="field">
                    <label for="company">Nazwa firmy <small>(opcjonalnie)</small></label>
                    <input type="text" id="company" name="firma" autocomplete="organization">
                </div>
            </div>
            <div class="field">
                <label for="message">Wiadomość</label>
                <textarea id="message" name="message" placeholder="Czym zajmuje się firma, gdzie działa i co chcesz poprawić." required></textarea>
            </div>
            <label class="check">
                <input type="checkbox" name="zgoda" value="tak" required>
                <span>Zgadzam się na kontakt mailowy lub telefoniczny w sprawie mojego zapytania i oferty usług Jana Kobusa.</span>
            </label>
            <div>
                <button type="submit" class="btn btn-primary">Wyślij</button>
            </div>
            <p class="form-note">Administratorem danych jest Jan Kobus, Lubliniec. Dane służą tylko do odpowiedzi na to zapytanie. Formularz obsługuje Formspree.</p>
        </form>

        <aside class="aside">
            <h2>Szybciej przez audyt</h2>
            <p>Chcesz wiedzieć, jak Twoja firma wypada w Mapach Google i ChatGPT? Wypełnij krótki formularz audytu, wystarczy nazwa firmy i miasto.</p>
            <p><a href="/#audyt" class="btn btn-ghost">Darmowy audyt</a></p>
            <p>Telefon: <a href="tel:+48732800250">732 800 250</a></p>
        </aside>
    </section>

    <script is:inline>
    (() => {
      const sel = document.getElementById('type');
      const subject = document.querySelector('input[name="_subject"]');
      const temat = new URLSearchParams(location.search).get('temat');
      if (temat && [...sel.options].some(o => o.value === temat)) sel.value = temat;
      const apply = () => { subject.value = 'Nowe zapytanie z jankobus.com: ' + sel.options[sel.selectedIndex].text; };
      sel.addEventListener('change', apply);
      apply();
    })();
    </script>
</Layout>
