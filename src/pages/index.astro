---
import Layout from '../layouts/Layout.astro';

const plans = [
  {
    id: 'AUD',
    track: 't1',
    name: 'Audyt',
    price: '0 zł',
    unit: 'bez zobowiązań',
    items: [
      'Pozycja w Mapach Google na hasła Twoich klientów',
      'Porównanie z 3 najbliższymi konkurentami',
      'Test: czy ChatGPT poleca Twoją firmę',
      'Lista konkretnych poprawek na jednej stronie'
    ],
    cta: 'Zamów darmowy audyt'
  },
  {
    id: 'WDR',
    track: 'a1',
    name: 'Wdrożenie',
    price: 'od 300 zł',
    unit: 'jednorazowo',
    items: [
      'Kategorie, usługi z cenami, godziny i opis w wizytówce',
      'Nowe zdjęcia i krótki film zrobione na miejscu',
      'Spójne dane firmy w Bing, Apple Maps i na Facebooku',
      'Kod QR i link do zbierania prawdziwych opinii',
      'Raport przed i po'
    ],
    cta: 'Zacznij od audytu'
  },
  {
    id: 'OPK',
    track: 'v1',
    name: 'Stała opieka',
    price: 'od 150 zł',
    unit: 'miesięcznie',
    items: [
      'Post w wizytówce co tydzień, ze zdjęć, które mi przesyłasz',
      'Odpowiedzi na opinie klientów',
      'Godziny świąteczne i bieżące zmiany',
      'Co miesiąc raport: wyświetlenia, telefony, test w ChatGPT',
      'Bez umowy na czas określony'
    ],
    cta: 'Zacznij od audytu'
  }
];

const faq = [
  {
    q: 'Ile kosztuje pozycjonowanie wizytówki Google?',
    a: 'Audyt jest darmowy. Jednorazowe wdrożenie kosztuje od 300 zł, a stała opieka od 150 zł miesięcznie. Dokładną cenę podaję po audycie, bo zależy od branży i stanu profilu.'
  },
  {
    q: 'Czy audyt jest naprawdę darmowy?',
    a: 'Tak. Sprawdzam Twoją wizytówkę i to, co o firmie mówią Google i ChatGPT, a potem wysyłam listę poprawek. Możesz wdrożyć je sam albo zlecić mnie. Nic nie musisz kupować.'
  },
  {
    q: 'Gwarantujesz, że ChatGPT zacznie polecać moją firmę?',
    a: 'Nie, i nikt uczciwy tego nie zagwarantuje. Mogę zadbać o to, z czego korzystają Google i asystenci AI: kompletne i spójne dane firmy, aktualne zdjęcia, opinie i treści. W raporcie co miesiąc widzisz, jak się to zmienia.'
  },
  {
    q: 'Potrzebujesz hasła do mojego konta Google?',
    a: 'Nie. Dodajesz mnie jako menedżera w profilu firmy w Google. Właścicielem zostajesz Ty i w każdej chwili możesz mnie usunąć.'
  },
  {
    q: 'Kupujesz albo dodajesz opinie?',
    a: 'Nie. Fałszywe opinie łamią zasady Google i prawo, a za ich publikowanie UOKiK nakłada kary. Pomagam zbierać prawdziwe opinie od Twoich klientów: kod QR przy kasie, link w SMS-ie albo na paragonie.'
  },
  {
    q: 'Czy muszę mieć stronę internetową?',
    a: 'Nie, wizytówka w Google działa też bez strony. Większość klientów i tak dzwoni albo przyjeżdża prosto z Map Google.'
  },
  {
    q: 'Kiedy zobaczę efekty?',
    a: 'Poprawki w profilu widać od razu. Wyższa pozycja w Mapach i obecność w odpowiedziach AI to zwykle kwestia kilku tygodni do kilku miesięcy, zależnie od branży i konkurencji.'
  },
  {
    q: 'Pracujesz tylko z firmami z Lublińca?',
    a: 'Najczęściej z firmami z Lublińca, Częstochowy, Tarnowskich Gór i okolicznych gmin, bo mogę wpaść na miejsce i zrobić zdjęcia. Wizytówkę poprawię zdalnie dla firmy z każdego miejsca w Polsce.'
  }
];

const caseStats = [
  { value: '171 tys.', label: 'wyświetleń w Google w 3 miesiące' },
  { value: '7,5', label: 'średnia pozycja w Google' },
  { value: '125 tys.+', label: 'podstron w mapie strony' }
];

const areaServed = ['Lubliniec', 'Częstochowa', 'Tarnowskie Góry', 'Koszęcin', 'Woźniki', 'Kalety', 'Herby', 'Ciasna', 'Dobrodzień']
  .map(name => ({ '@type': 'City', name }));

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': 'https://jankobus.com',
    name: 'Jan Kobus – wizytówki Google i widoczność w ChatGPT',
    description: 'Pozycjonowanie wizytówek Google i widoczność lokalnych firm w ChatGPT. Darmowy audyt, wdrożenie i stała opieka. Lubliniec i okolice.',
    url: 'https://jankobus.com/',
    logo: 'https://jankobus.com/apple-touch-icon.png',
    image: 'https://jankobus.com/og-widocznosc.png',
    priceRange: '0–300 zł',
    telephone: '+48732800250',
    geo: { '@type': 'GeoCoordinates', latitude: 50.6715, longitude: 18.6965 },
    address: { '@type': 'PostalAddress', addressLocality: 'Lubliniec', addressRegion: 'Śląskie', postalCode: '42-700', addressCountry: 'PL' },
    areaServed: [...areaServed, { '@type': 'Country', name: 'Polska' }],
    knowsAbout: ['Wizytówka Google', 'Google Maps', 'Pozycjonowanie lokalne', 'Lokalne SEO', 'Widoczność w ChatGPT', 'SEO'],
    sameAs: ['https://www.facebook.com/profile.php?id=61587671346611', 'https://www.instagram.com/redix.45/'],
    founder: { '@type': 'Person', name: 'Jan Kobus', url: 'https://jankobus.com/o-mnie/' },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Widoczność w Google Maps i ChatGPT',
      itemListElement: plans.map(p => ({
        '@type': 'Offer',
        name: p.name,
        price: p.price.replace(/\D/g, '') || '0',
        priceCurrency: 'PLN',
        itemOffered: { '@type': 'Service', name: `${p.name} – wizytówka Google` }
      }))
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))
  }
];
---

<Layout
    title="Wizytówka Google i pozycjonowanie lokalne Lubliniec | Jan Kobus"
    description="Pozycjonowanie wizytówki Google w Lublińcu i okolicach: darmowy audyt, wyższa pozycja w Mapach Google i widoczność w ChatGPT. Lubliniec, Częstochowa, Tarnowskie Góry. Tel. 732 800 250."
    canonical="https://jankobus.com/"
    structuredData={structuredData}
>
    <section class="hero">
        <div class="hero-copy">
            <p class="eyebrow">Pozycjonowanie lokalne · Google Maps · ChatGPT · Lubliniec</p>
            <h1 class="display display-hero">Wizytówka Google, którą <span class="cut">klienci znajdują.</span></h1>
            <p class="lead">
                Klienci coraz częściej nie przeglądają stron, tylko pytają: „dobry mechanik w Lublińcu?”.
                Odpowiedź dają Mapy Google i asystenci AI, tacy jak ChatGPT, a oni wskazują tylko kilka firm.
                Sprawdzę za darmo, czy jesteś wśród nich, i pokażę, co poprawić.
            </p>
            <div class="actions">
                <a href="#audyt" class="btn btn-primary">Darmowy audyt</a>
                <a href="#badanie" class="btn btn-ghost">Zobacz badanie z Lublińca</a>
            </div>
            <p class="contact-phone">Wolisz zadzwonić? <a class="phone" href="tel:+48732800250">732 800 250</a></p>
        </div>

        <figure class="chat-mock" aria-label="Przykład: pytanie do ChatGPT o firmę w Lublińcu">
            <div class="chat-bar"><span>ChatGPT</span><span>wyszukiwanie</span></div>
            <div class="chat-body">
                <p class="chat-q">Polecisz dobrego mechanika w Lublińcu?</p>
                <div class="chat-a">
                    Polecam te trzy warsztaty:
                    <ol>
                        <li><span style="width: 9em"></span></li>
                        <li><span style="width: 7em"></span></li>
                        <li><span style="width: 8em"></span></li>
                    </ol>
                </div>
                <p class="chat-miss">Jest tam Twoja firma? <span>W 9 branżach w Lublińcu co najmniej 3 na 4 firmy nie.</span></p>
            </div>
        </figure>
    </section>

    <section class="block" id="badanie">
        <div class="block-head reveal">
            <h2 class="h2">Badanie: 113 firm z Lublińca</h2>
            <p class="block-sub">W październiku 2026 zapytałem ChatGPT o 9 branż w Lublińcu i porównałem odpowiedzi z wynikami w Mapach Google.</p>
        </div>
        <div class="stats reveal">
            <div><b>113</b><span>firm w 9 branżach: mechanicy, fryzjerzy, kosmetyczki, fizjoterapeuci, hydraulicy, elektrycy, kwiaciarnie, salony manicure, szkoły jazdy</span></div>
            <div><b>3</b><span>firmy w każdej branży ChatGPT wskazał z nazwy. Zwykle te z najwięcej opiniami i najlepiej uzupełnioną wizytówką.</span></div>
            <div><b>76%+</b><span>firm nie pojawiło się w żadnej odpowiedzi. Klient, który zapyta AI, dostaje kontakt do konkurencji.</span></div>
        </div>
        <p class="study-note reveal">
            <strong>Co z tego wynika:</strong> asystenci AI polecają firmy, o których w sieci jest najwięcej spójnych i świeżych informacji,
            a te pochodzą przede wszystkim z wizytówki Google i opinii. To da się poprawić, i zwykle szybciej, niż myślisz.
        </p>
    </section>

    <section class="block" id="co-sprawdzam">
        <div class="block-head reveal">
            <h2 class="h2">Co sprawdzam w audycie</h2>
            <p class="block-sub">Google i asystenci AI polecają firmy, o których mają pełne, spójne i świeże informacje. Sprawdzam każde z tych miejsc.</p>
        </div>
        <ol class="tracks">
            <li class="track track-t1 reveal">
                <span class="track-id">MAP</span>
                <div class="track-body">
                    <h3>Wizytówka w Mapach Google</h3>
                    <p>Kategorie, usługi, godziny, opis, zdjęcia i posty. Najczęściej brakuje tu rzeczy, które da się poprawić w jeden dzień.</p>
                </div>
                <span class="track-lane" aria-hidden="true"><i style="--l:0;--w:24"></i><i style="--l:28;--w:14"></i><i style="--l:46;--w:30"></i><i style="--l:80;--w:14"></i></span>
            </li>
            <li class="track track-v1 reveal">
                <span class="track-id">AI</span>
                <div class="track-body">
                    <h3>ChatGPT, Gemini, Perplexity</h3>
                    <p>Zadaję asystentom pytania, które zadają Twoi klienci, i sprawdzam, kogo polecają, a kogo pomijają.</p>
                </div>
                <span class="track-lane" aria-hidden="true"><i style="--l:6;--w:10"></i><i style="--l:22;--w:18"></i><i style="--l:46;--w:8"></i><i style="--l:60;--w:22"></i></span>
            </li>
            <li class="track track-v2 reveal">
                <span class="track-id">NAP</span>
                <div class="track-body">
                    <h3>Spójne dane firmy</h3>
                    <p>Nazwa, adres i telefon w Bing, Apple Maps, na Facebooku i w katalogach firm. Rozbieżności mylą Google i AI.</p>
                </div>
                <span class="track-lane" aria-hidden="true"><i style="--l:4;--w:8"></i><i style="--l:16;--w:12"></i><i style="--l:32;--w:8"></i><i style="--l:46;--w:14"></i><i style="--l:66;--w:10"></i><i style="--l:82;--w:12"></i></span>
            </li>
            <li class="track track-a1 reveal">
                <span class="track-id">OPN</span>
                <div class="track-body">
                    <h3>Opinie</h3>
                    <p>Liczba, średnia, świeżość i odpowiedzi właściciela. Na tym AI w dużej mierze opiera polecenia.</p>
                </div>
                <span class="track-lane track-wave" aria-hidden="true"></span>
            </li>
            <li class="track track-c reveal">
                <span class="track-id">KON</span>
                <div class="track-body">
                    <h3>Konkurencja</h3>
                    <p>Porównanie z trzema firmami, które Google pokazuje nad Tobą: opinie, zdjęcia, aktywność.</p>
                </div>
                <span class="track-lane track-grade" aria-hidden="true"></span>
            </li>
        </ol>
    </section>

    <section class="block" id="wyniki">
        <div class="block-head reveal">
            <h2 class="h2">Wyniki z Google: ogarnijegzamin.pl</h2>
            <p class="block-sub">Mój własny projekt, zbudowany od zera tak, żeby Google rozumiał każdą z ponad 125 tysięcy podstron.</p>
        </div>
        <div class="case reveal">
            <div class="case-side">
                <a class="site-link" href="https://ogarnijegzamin.pl/" target="_blank" rel="noopener">
                    <div class="site-frame">
                        <div class="site-bar" aria-hidden="true"><i></i><i></i><i></i><span>ogarnijegzamin.pl</span></div>
                        <picture>
                            <source srcset="/web/ogarnijegzamin.webp" type="image/webp">
                            <img src="/web/ogarnijegzamin.jpg" alt="Strona ogarnijegzamin.pl" width="1200" height="750" loading="lazy" decoding="async">
                        </picture>
                    </div>
                </a>
                <dl class="site-stats">
                    {caseStats.map(s => (
                        <div>
                            <dt>{s.label}</dt>
                            <dd>{s.value}</dd>
                        </div>
                    ))}
                </dl>
                <p class="site-note">Wyświetlenia i pozycja: Google Search Console, 15.07–14.10.2026. Podstrony: mapa strony ogarnijegzamin.pl, październik 2026.</p>
            </div>
            <div class="case-body">
                <h3>Co zrobiłem</h3>
                <ol class="case-list">
                    <li><strong>Osobna strona na każde wyszukiwanie.</strong> 196 kwalifikacji ma własne strony, a każde z ok. 124 tys. pytań egzaminacyjnych ma swoją podstronę z odpowiedzią. Kto wpisze treść pytania w Google, może trafić prosto na odpowiedź.</li>
                    <li><strong>Unikalny tytuł i opis każdej podstrony</strong>, generowane automatycznie z treści pytania, kodu kwalifikacji i numeru.</li>
                    <li><strong>Dane strukturalne</strong> (QAPage, Course, BreadcrumbList), dzięki którym Google wie, że to pytanie z odpowiedzią albo kurs, a nie zwykły tekst.</li>
                    <li><strong>Porządek techniczny:</strong> adresy kanoniczne, mapa strony podzielona na 4 pliki, szybkie ładowanie na telefonie.</li>
                </ol>
                <figure class="serp" aria-label="Przykład: jak podstrona wygląda w wynikach wyszukiwania">
                    <figcaption>Tak podstrona pytania wygląda w wynikach wyszukiwania</figcaption>
                    <p class="serp-url">ogarnijegzamin.pl › pytania › aud-01 › 100</p>
                    <p class="serp-title">W okresie postprodukcji należy | AUD.01 pyt. 100 | ogarnijegzamin.pl</p>
                    <p class="serp-desc">W okresie postprodukcji należy — pytanie egzaminacyjne AUD.01 (AUD01) z odpowiedzią i wyjaśnieniem. Egzamin zawodowy CKE, darmowy dostęp.</p>
                </figure>
                <p class="case-bridge">
                    Lokalna firma potrzebuje tej samej zasady w mniejszej skali: kompletny profil w Mapach Google,
                    spójne dane w sieci i treści, które odpowiadają na pytania klientów. Wtedy Google i ChatGPT wiedzą, kogo polecić.
                </p>
            </div>
        </div>
    </section>

    <section class="block" id="pakiety">
        <div class="block-head reveal">
            <h2 class="h2">Pakiety</h2>
            <p class="block-sub">Zaczynamy od darmowego audytu. Dopiero gdy zobaczysz, co jest do poprawy, decydujesz, czy chcesz iść dalej.</p>
        </div>
        <div class="plans">
            {plans.map(p => (
                <article class={`plan track-${p.track} reveal`}>
                    <span class="plan-id">{p.id}</span>
                    <h3>{p.name}</h3>
                    <p class="plan-price">{p.price} <span>{p.unit}</span></p>
                    <ul>
                        {p.items.map(item => <li>{item}</li>)}
                    </ul>
                    <a href="#audyt" class={p.id === 'AUD' ? 'btn btn-primary' : 'btn btn-ghost'}>{p.cta}</a>
                </article>
            ))}
        </div>
        <p class="plans-note reveal">
            <strong>Zdjęcia i filmy na miejscu:</strong> do stałej opieki mogę dołożyć regularne zdjęcia i krótkie filmy do wizytówki. Profile z aktualnymi zdjęciami Google pokazuje chętniej.
            Ceny zależą od branży i stanu profilu, dokładną kwotę podaję po audycie.
        </p>
    </section>

    <section class="block" id="proces">
        <div class="block-head reveal">
            <h2 class="h2">Jak to wygląda</h2>
            <p class="block-sub">Od zgłoszenia do firmy, którą klienci znajdują.</p>
        </div>
        <ol class="steps">
            <li class="step reveal">
                <span class="step-tc">01</span>
                <h3>Zgłaszasz firmę</h3>
                <p>Wypełniasz krótki formularz poniżej. Wystarczy nazwa firmy i miasto.</p>
            </li>
            <li class="step reveal">
                <span class="step-tc">02</span>
                <h3>Dostajesz audyt</h3>
                <p>W ciągu 2 dni roboczych wysyłam jedną stronę: co jest źle, jak wypadasz na tle konkurencji i co mówią o Tobie AI.</p>
            </li>
            <li class="step reveal">
                <span class="step-tc">03</span>
                <h3>Wdrożenie</h3>
                <p>Jeśli chcesz, poprawiam wszystko za Ciebie. Dodajesz mnie jako menedżera profilu, hasła zostają u Ciebie.</p>
            </li>
            <li class="step reveal">
                <span class="step-tc">04</span>
                <h3>Opieka i raport</h3>
                <p>Profil żyje: posty, zdjęcia, odpowiedzi na opinie. Co miesiąc dostajesz raport z wynikami.</p>
            </li>
        </ol>
    </section>

    <section class="block" id="lokalnie">
        <div class="block-head reveal">
            <h2 class="h2">Pozycjonowanie lokalne w Lublińcu i okolicach</h2>
            <p class="block-sub">Klient z Lublińca szuka usługi w Lublińcu. Twoja wizytówka ma się pokazać właśnie jemu.</p>
        </div>
        <div class="local reveal">
            <p>
                Jestem z Lublińca i poprawiam wizytówki Google firm z Lublińca, Koszęcina, Woźnik, Kalet, Herb,
                Ciasnej i Dobrodzienia, a także z Częstochowy i Tarnowskich Gór. Najczęściej pracuję z warsztatami
                samochodowymi, wulkanizacjami, salonami fryzjerskimi i kosmetycznymi, gabinetami, kwiaciarniami
                i firmami usługowymi, które żyją z klientów z okolicy.
            </p>
            <p>
                Mogę przyjechać na miejsce, zrobić zdjęcia i krótkie filmy do wizytówki, a resztę ustalamy przez telefon albo maila.
                Firmy spoza regionu obsługuję zdalnie.
            </p>
        </div>
    </section>

    <section class="block" id="audyt">
        <div class="block-head reveal">
            <h2 class="h2">Darmowy audyt</h2>
            <p class="block-sub">Podaj nazwę firmy i miasto. Resztę sprawdzę sam i odezwę się z wynikami.</p>
        </div>
        <div class="contact contact-inline">
            <form class="form audit-form" action="https://formspree.io/f/mbdrgppo" method="POST">
                <input type="hidden" name="_subject" value="Darmowy audyt widoczności (jankobus.com)">
                <input type="hidden" name="temat" value="audyt-widocznosci">
                <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
                <div class="field-row">
                    <div class="field">
                        <label for="a-company">Nazwa firmy</label>
                        <input type="text" id="a-company" name="firma" autocomplete="organization" required>
                    </div>
                    <div class="field">
                        <label for="a-city">Miasto</label>
                        <input type="text" id="a-city" name="miasto" autocomplete="address-level2" placeholder="np. Lubliniec" required>
                    </div>
                </div>
                <div class="field-row">
                    <div class="field">
                        <label for="a-name">Imię</label>
                        <input type="text" id="a-name" name="name" autocomplete="name" required>
                    </div>
                    <div class="field">
                        <label for="a-email">Email</label>
                        <input type="email" id="a-email" name="email" autocomplete="email" required>
                    </div>
                </div>
                <div class="field-row">
                    <div class="field">
                        <label for="a-industry">Branża <small>(opcjonalnie)</small></label>
                        <input type="text" id="a-industry" name="branza" placeholder="np. warsztat, fryzjer, restauracja">
                    </div>
                    <div class="field">
                        <label for="a-phone">Telefon <small>(opcjonalnie)</small></label>
                        <input type="tel" id="a-phone" name="telefon" autocomplete="tel">
                    </div>
                </div>
                <div class="field">
                    <label for="a-link">Link do wizytówki Google albo strony <small>(opcjonalnie)</small></label>
                    <input type="url" id="a-link" name="link" placeholder="https://">
                </div>
                <div class="field">
                    <label for="a-message">Co chcesz poprawić? <small>(opcjonalnie)</small></label>
                    <textarea id="a-message" name="message" placeholder="np. mało telefonów z Google, konkurencja jest wyżej w Mapach"></textarea>
                </div>
                <label class="check">
                    <input type="checkbox" name="zgoda" value="tak" required>
                    <span>Zgadzam się na kontakt mailowy lub telefoniczny w sprawie audytu i oferty usług Jana Kobusa. Zgodę mogę wycofać w każdej chwili.</span>
                </label>
                <div>
                    <button type="submit" class="btn btn-primary">Wyślij zgłoszenie</button>
                </div>
                <p class="form-status" role="status" aria-live="polite" hidden></p>
                <p class="form-note">
                    Administratorem danych jest Jan Kobus, Lubliniec. Dane służą wyłącznie do przygotowania audytu i kontaktu w tej sprawie.
                    Formularz obsługuje Formspree.
                </p>
            </form>

            <aside class="aside">
                <h2>Co dostaniesz</h2>
                <ul>
                    <li>Zrzut ekranu: kogo Google pokazuje w Mapach na Twoje hasła.</li>
                    <li>Odpowiedź ChatGPT na pytanie o Twoją branżę w Twoim mieście.</li>
                    <li>Porównanie z trzema konkurentami.</li>
                    <li>Listę poprawek od najważniejszej.</li>
                </ul>
                <p>Bez zobowiązań. Możesz wdrożyć poprawki sam.</p>
                <p>Wolisz zadzwonić? <a class="phone" href="tel:+48732800250">732 800 250</a></p>
            </aside>
        </div>
    </section>

    <section class="block" id="faq">
        <div class="block-head reveal">
            <h2 class="h2">Pytania</h2>
        </div>
        <div class="faq">
            {faq.map(({ q, a }) => (
                <details class="faq-item reveal">
                    <summary>{q}</summary>
                    <p>{a}</p>
                </details>
            ))}
        </div>
    </section>

    <section class="end">
        <h2 class="display display-end">Sprawdź, czy Cię widać.</h2>
        <p class="lead">Audyt jest darmowy i do niczego nie zobowiązuje. Możesz też zadzwonić: <a class="phone" href="tel:+48732800250">732 800 250</a></p>
        <a href="#audyt" class="btn btn-primary">Zamów darmowy audyt</a>
    </section>

    <script is:inline>
    (() => {
      // Wysyłka bez przeładowania; bez JS formularz działa zwykłym POST-em do Formspree
      const form = document.querySelector('.audit-form');
      if (!form) return;
      const status = form.querySelector('.form-status');
      const btn = form.querySelector('button[type="submit"]');
      const subject = form.querySelector('input[name="_subject"]');
      const show = (text, ok) => { status.hidden = false; status.textContent = text; status.classList.toggle('ok', ok); };

      form.addEventListener('submit', async e => {
        e.preventDefault();
        subject.value = 'Darmowy audyt: ' + form.firma.value + ' (' + form.miasto.value + ')';
        btn.disabled = true;
        btn.textContent = 'Wysyłam…';
        try {
          const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error(res.status);
          form.reset();
          show('Dzięki! Zgłoszenie dotarło. Audyt wyślę mailem w ciągu 2 dni roboczych.', true);
        } catch {
          show('Nie udało się wysłać. Spróbuj ponownie albo zadzwoń: 732 800 250.', false);
        } finally {
          btn.disabled = false;
          btn.textContent = 'Wyślij zgłoszenie';
        }
      });
    })();
    </script>
</Layout>
