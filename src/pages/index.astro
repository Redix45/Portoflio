---
import ReelLayout from '../layouts/ReelLayout.astro';
import { reels, REEL_SLOTS } from '../data/reels';
import { sites } from '../data/sites';
import SiteCard from '../components/SiteCard.astro';

const faq = [
  {
    q: 'Ile kosztuje montaż rolki?',
    a: 'Zależy od długości materiału, liczby ujęć i efektów. Cenę podaję z góry, po obejrzeniu materiału. Przy stałej współpracy (kilka rolek w miesiącu) wychodzi taniej za sztukę.'
  },
  {
    q: 'Kto nagrywa materiał?',
    a: 'Ty. Ja zajmuję się wyłącznie montażem i pracuję zdalnie na materiale, który mi wyślesz, więc nie ma znaczenia, skąd jesteś.'
  },
  {
    q: 'Czy muszę mieć profesjonalny sprzęt?',
    a: 'Nie. Telefon w zupełności wystarczy. Nagrywaj w pionie, przy dobrym świetle i łap kilka sekund przed i po akcji. Resztę zrobię w montażu.'
  },
  {
    q: 'Skąd bierzesz muzykę?',
    a: 'Dobieram utwór pod klimat rolki i tniemy pod jego rytm. Na Instagramie i TikToku najbezpieczniej dodać popularny dźwięk już w aplikacji, dlatego zawsze dostajesz też wersję bez muzyki.'
  },
  {
    q: 'Ile kosztuje strona internetowa?',
    a: 'Zależy od liczby podstron i funkcji. Po krótkiej rozmowie podaję cenę z góry, bez dopłat w trakcie.'
  },
  {
    q: 'Czy gwarantujesz pierwsze miejsce w Google?',
    a: 'Nie, i nikt uczciwy tego nie zagwarantuje. Gwarantuję, że strona będzie technicznie przygotowana pod Google, a Ty dostaniesz dostęp do Search Console, żeby widzieć, jak rośnie widoczność.'
  }
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': 'https://jankobus.com',
    name: 'Jan Kobus – rolki, strony internetowe, SEO',
    description: 'Montaż rolek na Instagram Reels, TikToka i YouTube Shorts oraz szybkie strony internetowe z SEO. Lubliniec i zdalnie w całej Polsce.',
    url: 'https://jankobus.com/',
    logo: 'https://jankobus.com/apple-touch-icon.png',
    priceRange: '$$',
    telephone: '+48732800250',
    geo: { '@type': 'GeoCoordinates', latitude: 50.6715, longitude: 18.6965 },
    address: { '@type': 'PostalAddress', addressLocality: 'Lubliniec', addressRegion: 'Śląskie', postalCode: '42-700', addressCountry: 'PL' },
    areaServed: [
      { '@type': 'City', name: 'Lubliniec' },
      { '@type': 'City', name: 'Częstochowa' },
      { '@type': 'City', name: 'Tarnowskie Góry' },
      { '@type': 'City', name: 'Koszęcin' },
      { '@type': 'City', name: 'Woźniki' },
      { '@type': 'City', name: 'Kalety' },
      { '@type': 'City', name: 'Herby' },
      { '@type': 'City', name: 'Ciasna' },
      { '@type': 'City', name: 'Dobrodzień' },
      { '@type': 'State', name: 'Województwo Śląskie' },
      { '@type': 'Country', name: 'Polska' }
    ],
    knowsAbout: ['Montaż wideo', 'Instagram Reels', 'TikTok', 'YouTube Shorts', 'Napisy do filmów', 'Korekcja kolorów', 'Tworzenie stron internetowych', 'SEO', 'Lokalne SEO'],
    sameAs: ['https://www.facebook.com/profile.php?id=61587671346611', 'https://www.instagram.com/redix.45/'],
    founder: { '@type': 'Person', name: 'Jan Kobus', jobTitle: 'Montażysta wideo i twórca stron internetowych', url: 'https://jankobus.com/o-mnie/' }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))
  }
];

const emptySlots = Math.max(0, REEL_SLOTS - reels.length);
---

<ReelLayout
    title="Montaż rolek i strony internetowe Lubliniec | Jan Kobus"
    description="Montuję rolki na Instagram Reels, TikToka i YouTube Shorts oraz robię szybkie strony internetowe z SEO, żeby klienci znajdowali Cię w Google. Lubliniec i zdalnie w całej Polsce."
    canonical="https://jankobus.com/"
    structuredData={structuredData}
>

    <!-- HOOK -->
    <section class="hero" data-clip="Hook" data-track="t1">
        <div class="hero-copy">
            <p class="eyebrow">Rolki · Strony internetowe · SEO</p>
            <h1 class="display display-hero">
                Rolki, które się <span class="cut">ogląda.</span><br>
                Strony, które się <span class="cut cut-alt">znajduje.</span>
            </h1>
            <p class="lead">
                Montuję pionowe rolki na Reels, TikToka i Shorts z Twojego materiału.
                Robię też szybkie strony internetowe i dbam o to, żeby klienci znajdowali je w Google.
            </p>
            <div class="actions">
                <a href="/kontakt/?temat=rolka-firma" class="btn btn-primary">Zamów rolkę</a>
                <a href="/kontakt/?temat=strona" class="btn btn-ghost">Zamów stronę</a>
            </div>
        </div>

        <div class="hero-visual">
        <div class="hero-browser site-frame" aria-hidden="true">
            <div class="site-bar"><i></i><i></i><i></i><span>ogarnijegzamin.pl</span></div>
            <picture>
                <source srcset="/web/ogarnijegzamin.webp" type="image/webp">
                <img src="/web/ogarnijegzamin.jpg" alt="" width="1200" height="750" decoding="async">
            </picture>
        </div>
        <figure class="monitor" aria-label="Podgląd: przykładowa rolka cięta pod rytm">
            <div class="monitor-bar">
                <span>Program</span>
                <span class="monitor-tc">00:00:00:00</span>
            </div>
            <div class="screen">
                <div class="shot shot-1" data-name="A001 · wesele"></div>
                <div class="shot shot-2" data-name="A002 · mieszkanie"></div>
                <div class="shot shot-3" data-name="A003 · koncert"></div>
                <div class="shot shot-4" data-name="A004 · produkt"></div>
                <span class="shot-label">A001 · wesele</span>
                <div class="safe" aria-hidden="true"><span>bezpieczna strefa</span></div>
                <p class="caption" aria-live="off"><span>STOP</span></p>
                <div class="beat" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            </div>
            <figcaption class="monitor-meta">1080×1920 · 30 fps · 120 BPM</figcaption>
        </figure>
        </div>
    </section>

    <!-- REALIZACJE -->
    <section class="block" id="realizacje" data-clip="Realizacje" data-track="v1">
        <div class="block-head reveal">
            <h2 class="h2">Realizacje</h2>
            <p class="block-sub">
                {reels.length
                  ? 'Rolki i strony, które zrobiłem. Kliknij rolkę, żeby obejrzeć ją w powiększeniu z dźwiękiem.'
                  : 'Tu trafią gotowe rolki. Na razie sloty są wolne. Jeden może być Twój.'}
            </p>
        </div>
        <h3 class="sub-h reveal"><span class="track-dot track-v1"></span>Rolki</h3>
        <div class="reel-grid">
            {reels.map(r => (
                <figure class={`reel track-${r.track} reveal`}>
                    <video src={r.src} poster={r.poster} muted loop playsinline preload="none"></video>
                    <figcaption>
                        <span class="reel-tag">{r.category}</span>
                        <span class="reel-title">{r.title}</span>
                        <span class="reel-dur">{r.duration}</span>
                    </figcaption>
                    <button class="reel-open" type="button" data-src={r.srcHd || r.src} data-poster={r.poster} data-title={r.title} aria-label={`Powiększ rolkę: ${r.title}`}>
                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2"/></svg>
                    </button>
                </figure>
            ))}
            {Array.from({ length: emptySlots }).map((_, i) => (
                <a href="/kontakt/" class="reel reel-empty reveal" style={`--i:${i}`}>
                    <span class="reel-empty-tc">V1 · slot {String(reels.length + i + 1).padStart(2, '0')}</span>
                    <span class="reel-empty-title">Wolny slot</span>
                    <span class="reel-empty-cta">Twoja rolka tutaj →</span>
                </a>
            ))}
        </div>
        <h3 class="sub-h sub-h-gap reveal"><span class="track-dot track-a1"></span>Strony internetowe</h3>
        <div class="sites">
            {sites.map(site => <SiteCard site={site} />)}
        </div>
        <dialog class="viewer" aria-label="Podgląd rolki">
            <button class="viewer-close" type="button" aria-label="Zamknij">✕</button>
            <video class="viewer-video" controls playsinline loop></video>
            <p class="viewer-title"></p>
        </dialog>
    </section>

    <!-- USŁUGI jako ścieżki na osi czasu -->
    <section class="block" id="uslugi" data-clip="Usługi" data-track="v2">
        <div class="block-head reveal">
            <h2 class="h2">Montaż rolek</h2>
            <p class="block-sub">Każda rolka przechodzi przez te same ścieżki, jak na osi czasu w programie do montażu.</p>
        </div>
        <ol class="tracks">
            <li class="track track-v1 reveal">
                <span class="track-id">V1</span>
                <div class="track-body">
                    <h3>Cięcie</h3>
                    <p>Montaż pod rytm muzyki, tempo dobrane do platformy i haczyk w pierwszej sekundzie. Bez dłużyzn.</p>
                </div>
                <span class="track-lane" aria-hidden="true"><i style="--l:0;--w:18"></i><i style="--l:20;--w:9"></i><i style="--l:31;--w:14"></i><i style="--l:47;--w:7"></i><i style="--l:56;--w:20"></i><i style="--l:78;--w:12"></i></span>
            </li>
            <li class="track track-v2 reveal">
                <span class="track-id">V2</span>
                <div class="track-body">
                    <h3>Efekty</h3>
                    <p>Zoomy, przejścia, slow motion, stabilizacja. Tylko tam, gdzie pomagają historii.</p>
                </div>
                <span class="track-lane" aria-hidden="true"><i style="--l:14;--w:6"></i><i style="--l:44;--w:10"></i><i style="--l:70;--w:8"></i></span>
            </li>
            <li class="track track-t1 reveal">
                <span class="track-id">T1</span>
                <div class="track-body">
                    <h3>Napisy</h3>
                    <p>Dynamiczne napisy słowo po słowie, tytuły i hasła. Większość ludzi ogląda rolki bez dźwięku, więc tekst niesie przekaz.</p>
                </div>
                <span class="track-lane" aria-hidden="true"><i style="--l:2;--w:10"></i><i style="--l:13;--w:8"></i><i style="--l:23;--w:12"></i><i style="--l:38;--w:9"></i><i style="--l:50;--w:11"></i><i style="--l:64;--w:7"></i><i style="--l:74;--w:14"></i></span>
            </li>
            <li class="track track-a1 reveal">
                <span class="track-id">A1</span>
                <div class="track-body">
                    <h3>Dźwięk</h3>
                    <p>Muzyka dobrana do klimatu, oczyszczony głos i głośność wyrównana pod Instagrama i TikToka.</p>
                </div>
                <span class="track-lane track-wave" aria-hidden="true"></span>
            </li>
            <li class="track track-c reveal">
                <span class="track-id">C</span>
                <div class="track-body">
                    <h3>Kolor</h3>
                    <p>Korekcja i spójny wygląd ujęć, nawet jeśli nagrywały je trzy różne telefony.</p>
                </div>
                <span class="track-lane track-grade" aria-hidden="true"></span>
            </li>
        </ol>
    </section>

    <!-- STRONY I SEO -->
    <section class="block" id="strony" data-clip="Strony i SEO" data-track="a1">
        <div class="block-head reveal">
            <h2 class="h2">Strony i SEO</h2>
            <p class="block-sub">Dobra rolka przyciąga uwagę, ale klient, który szuka usługi w Google, musi trafić na Twoją stronę.</p>
        </div>
        <ul class="also-list also-cols reveal">
            <li>
                <h3>Strony internetowe</h3>
                <p>Szybkie strony-wizytówki i landingi dla firm, pisane od zera i dobrze wyglądające na telefonie.</p>
            </li>
            <li>
                <h3>SEO i Google</h3>
                <p>SEO techniczne, wizytówka w Mapach Google i Search Console, żeby klienci trafiali do Ciebie z wyszukiwarki.</p>
            </li>
            <li>
                <h3>Wszystko w jednym miejscu</h3>
                <p>Rolki, które montuję, mogą od razu trafić na Twoją stronę, a całość wygląda spójnie.</p>
            </li>
        </ul>
        <div class="actions also-actions reveal">
            <a href="/strony-internetowe/" class="btn btn-primary">Więcej o stronach i SEO →</a>
            <a href="/kontakt/?temat=strona" class="btn btn-ghost">Zapytaj o stronę</a>
        </div>
    </section>

    <!-- DLA KOGO -->
    <section class="block" id="dla-kogo" data-clip="Dla kogo" data-track="a1">
        <div class="block-head reveal">
            <h2 class="h2">Dla kogo pracuję</h2>
        </div>
        <div class="who">
            <article class="who-item reveal">
                <h3>Lokalne firmy</h3>
                <p>Rolki co tydzień albo co miesiąc w jednym stylu i strona, na którą trafiają klienci z Google.</p>
            </article>
            <article class="who-item reveal">
                <h3>Wesela i imprezy</h3>
                <p>30–60 sekund najlepszych momentów: pierwszy taniec, tort, parkiet. Gotowe do wrzucenia, póki goście jeszcze o tym mówią.</p>
            </article>
            <article class="who-item reveal">
                <h3>Nieruchomości</h3>
                <p>Przejście przez mieszkanie lub dom w pionie, z metrażem i ceną na ekranie. Kupujący widzi układ mieszkania, zanim przyjedzie na oglądanie.</p>
            </article>
            <article class="who-item reveal">
                <h3>Eventy i koncerty</h3>
                <p>Energia z sali zamknięta w pół minuty. Zapowiedź przed wydarzeniem albo podsumowanie po nim.</p>
            </article>
        </div>
    </section>

    <!-- PROCES: prawdziwa kolejność kroków -->
    <section class="block" id="proces" data-clip="Proces" data-track="t1">
        <div class="block-head reveal">
            <h2 class="h2">Jak pracuję</h2>
            <p class="block-sub">Od pierwszej wiadomości do gotowej rolki albo strony.</p>
        </div>
        <ol class="steps">
            <li class="step reveal">
                <span class="step-tc">00:00</span>
                <h3>Piszesz, czego potrzebujesz</h3>
                <p>Rolka: wyślij materiał przez Google Drive albo WeTransfer. Strona: napisz, czym się zajmujesz i dla kogo.</p>
            </li>
            <li class="step reveal">
                <span class="step-tc">00:05</span>
                <h3>Dostajesz wycenę</h3>
                <p>Odpisuję z ceną i terminem. Zaczynam dopiero, gdy się zgodzisz.</p>
            </li>
            <li class="step reveal">
                <span class="step-tc">00:15</span>
                <h3>Robię</h3>
                <p>Pierwszą wersję rolki dostajesz zwykle w 2–4 dni robocze. Stronę widzisz na żywym podglądzie w trakcie pracy.</p>
            </li>
            <li class="step reveal">
                <span class="step-tc">00:40</span>
                <h3>Poprawki i oddanie</h3>
                <p>Nanoszę Twoje uwagi. Rolka: finalny MP4 i wersja bez muzyki. Strona: publikacja, domena i Search Console.</p>
            </li>
        </ol>
    </section>

    <!-- FAQ -->
    <section class="block" id="faq" data-clip="FAQ" data-track="v2">
        <div class="block-head reveal">
            <h2 class="h2">Pytania</h2>
        </div>
        <div class="faq">
            {faq.map(({ q, a }) => (
                <details class="faq-item reveal">
                    <summary>{q}</summary>
                    <p>{a}</p>
                </details>
            ))}
        </div>
    </section>

    <!-- CTA -->
    <section class="end" data-clip="Kontakt" data-track="v1">
        <h2 class="display display-end">Rolka czy strona?</h2>
        <p class="lead">Napisz, czego potrzebujesz, albo zadzwoń: <a class="phone" href="tel:+48732800250">732 800 250</a></p>
        <div class="actions">
            <a href="/kontakt/?temat=rolka-firma" class="btn btn-primary">Zamów rolkę</a>
            <a href="/kontakt/?temat=strona" class="btn btn-ghost">Zamów stronę</a>
        </div>
    </section>

    <script is:inline>
    (() => {
      // Podgląd w hero: cięcie co 2 beaty, napis co beat (120 BPM = 500 ms)
      const screen = document.querySelector('.screen');
      if (!screen) return;
      const shots = [...screen.querySelectorAll('.shot')];
      const label = screen.querySelector('.shot-label');
      const cap = screen.querySelector('.caption span');
      const beats = [...screen.querySelectorAll('.beat i')];
      const monTc = document.querySelector('.monitor-tc');
      const words = ['STOP', 'SCROLLA', 'TO', 'TWOJA', 'ROLKA', 'POD', 'BEAT', 'Z', 'NAPISAMI', 'DO', 'KOŃCA'];
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      let beat = 0, shot = 0;
      shots[0].classList.add('on');
      const tick = () => {
        beats.forEach((b, i) => b.classList.toggle('on', i === beat % 4));
        if (beat % 2 === 0) {
          shots[shot].classList.remove('on');
          shot = (shot + 1) % shots.length;
          shots[shot].classList.add('on');
          label.textContent = shots[shot].dataset.name;
          screen.classList.remove('punch'); void screen.offsetWidth; screen.classList.add('punch');
        }
        cap.textContent = words[beat % words.length];
        cap.classList.remove('pop'); void cap.offsetWidth; cap.classList.add('pop');
        beat++;
      };
      if (reduce) { cap.textContent = 'TWOJA ROLKA'; return; }
      setInterval(tick, 500);
      const t0 = performance.now();
      const frame = () => {
        monTc.textContent = window.__tc(Math.floor((performance.now() - t0) / 1000 * 30) % (45 * 30));
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    })();

    // Realizacje: rolka gra bez dźwięku, gdy jest na ekranie; klik otwiera powiększenie z dźwiękiem
    (() => {
      const videos = [...document.querySelectorAll('.reel video')];
      if (!videos.length) return;
      const io = new IntersectionObserver(entries => entries.forEach(e => {
        if (e.isIntersecting && !viewer.open) e.target.play().catch(() => {});
        else e.target.pause();
      }), { threshold: 0.5 });
      videos.forEach(v => io.observe(v));

      const viewer = document.querySelector('.viewer');
      const big = viewer.querySelector('.viewer-video');
      const title = viewer.querySelector('.viewer-title');
      let opener = null;

      document.querySelectorAll('.reel-open').forEach(btn => btn.addEventListener('click', () => {
        opener = btn;
        videos.forEach(v => v.pause());
        big.src = btn.dataset.src;
        big.poster = btn.dataset.poster;
        title.textContent = btn.dataset.title;
        viewer.showModal();
        big.muted = false;
        big.play().catch(() => {});
      }));

      const close = () => viewer.close();
      viewer.querySelector('.viewer-close').addEventListener('click', close);
      // klik w tło (poza filmem) zamyka
      viewer.addEventListener('click', e => { if (e.target === viewer) close(); });
      viewer.addEventListener('close', () => {
        big.pause();
        big.removeAttribute('src'); big.load();
        opener?.focus();
        videos.forEach(v => {
          const r = v.getBoundingClientRect();
          if (r.top < innerHeight && r.bottom > 0) v.play().catch(() => {});
        });
      });
    })();
    </script>
</ReelLayout>
