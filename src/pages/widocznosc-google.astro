---
import ReelLayout from '../layouts/ReelLayout.astro';

const plans = [
  {
    id: 'AUD',
    track: 't1',
    name: 'Audyt',
    price: '0 zł',
    unit: 'bez zobowiązań',
    items: [
      'Przegląd wizytówki w Mapach Google',
      'Porównanie z 3 najbliższymi konkurentami',
      'Test: czy ChatGPT, Gemini i Perplexity polecają Twoją firmę',
      'Lista konkretnych poprawek na jednej stronie'
    ],
    cta: 'Zamów darmowy audyt'
  },
  {
    id: 'WDR',
    track: 'a1',
    name: 'Wdrożenie',
    price: 'od 300 zł',
    unit: 'jednorazowo',
    items: [
      'Uzupełniona i poprawiona wizytówka: kategorie, usługi, godziny, opis',
      'Nowe zdjęcia albo krótkie wideo do profilu',
      'Spójne dane firmy w Bing, Apple Maps, Facebooku i katalogach',
      'Kod QR i link do zbierania prawdziwych opinii',
      'Raport przed i po'
    ],
    cta: 'Zacznij od audytu'
  },
  {
    id: 'OPK',
    track: 'v1',
    name: 'Stała opieka',
    price: 'od 150 zł',
    unit: 'miesięcznie',
    items: [
      'Posty i świeże zdjęcia w wizytówce co tydzień',
      'Odpowiedzi na opinie klientów',
      'Godziny świąteczne i bieżące zmiany',
      'Co miesiąc raport: wyświetlenia, telefony, test w ChatGPT',
      'Bez umowy na czas określony'
    ],
    cta: 'Zacznij od audytu'
  }
];

const faq = [
  {
    q: 'Czy audyt jest naprawdę darmowy?',
    a: 'Tak. Sprawdzam Twoją wizytówkę i to, co o firmie mówią Google i ChatGPT, a potem wysyłam listę poprawek. Możesz wdrożyć je sam albo zlecić mnie. Nic nie musisz kupować.'
  },
  {
    q: 'Gwarantujesz, że ChatGPT zacznie polecać moją firmę?',
    a: 'Nie, i nikt uczciwy tego nie zagwarantuje. Mogę zadbać o to, z czego korzystają Google i asystenci AI: kompletne i spójne dane firmy, aktualne zdjęcia, opinie i treści. W raporcie co miesiąc widzisz, jak się to zmienia.'
  },
  {
    q: 'Potrzebujesz hasła do mojego konta Google?',
    a: 'Nie. Dodajesz mnie jako menedżera w profilu firmy w Google. Właścicielem zostajesz Ty i w każdej chwili możesz mnie usunąć.'
  },
  {
    q: 'Kupujesz albo dodajesz opinie?',
    a: 'Nie. Fałszywe opinie łamią zasady Google i prawo, a za ich publikowanie UOKiK nakłada kary. Pomagam zbierać prawdziwe opinie od Twoich klientów: kod QR przy kasie, link w SMS-ie albo na paragonie.'
  },
  {
    q: 'Czy muszę mieć stronę internetową?',
    a: 'Nie, wizytówka w Google działa też bez strony. Strona pomaga, bo Google i AI mają wtedy więcej informacji o firmie. Jeśli zechcesz, mogę ją zrobić.'
  },
  {
    q: 'Kiedy zobaczę efekty?',
    a: 'Poprawki w profilu widać od razu. Wyższa pozycja w Mapach i obecność w odpowiedziach AI to zwykle kwestia kilku tygodni do kilku miesięcy, zależnie od branży i konkurencji.'
  }
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Widoczność w Google Maps i ChatGPT',
    serviceType: ['Wizytówka Google', 'Pozycjonowanie lokalne', 'Google Maps', 'Widoczność w ChatGPT', 'Lokalne SEO'],
    description: 'Darmowy audyt i poprawa widoczności lokalnych firm w Mapach Google oraz w odpowiedziach ChatGPT, Gemini i Perplexity.',
    provider: {
      '@type': 'ProfessionalService',
      name: 'Jan Kobus – rolki, strony internetowe, SEO',
      url: 'https://jankobus.com/',
      telephone: '+48732800250',
      address: { '@type': 'PostalAddress', addressLocality: 'Lubliniec', addressRegion: 'Śląskie', postalCode: '42-700', addressCountry: 'PL' },
      geo: { '@type': 'GeoCoordinates', latitude: 50.6715, longitude: 18.6965 }
    },
    areaServed: [
      { '@type': 'City', name: 'Lubliniec' },
      { '@type': 'City', name: 'Częstochowa' },
      { '@type': 'City', name: 'Tarnowskie Góry' },
      { '@type': 'City', name: 'Koszęcin' },
      { '@type': 'City', name: 'Woźniki' },
      { '@type': 'City', name: 'Kalety' },
      { '@type': 'City', name: 'Herby' },
      { '@type': 'City', name: 'Ciasna' },
      { '@type': 'City', name: 'Dobrodzień' },
      { '@type': 'Country', name: 'Polska' }
    ],
    offers: plans.map(p => ({
      '@type': 'Offer',
      name: p.name,
      price: p.price.replace(/\D/g, '') || '0',
      priceCurrency: 'PLN'
    })),
    url: 'https://jankobus.com/widocznosc-google/'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))
  }
];
---

<ReelLayout
    title="Wizytówka Google i widoczność w ChatGPT – Lubliniec | Jan Kobus"
    description="Darmowy audyt widoczności firmy w Mapach Google i ChatGPT. Poprawiam wizytówki Google i dbam, żeby klienci z Lublińca i okolic znajdowali Twoją firmę. Tel. 732 800 250."
    canonical="https://jankobus.com/widocznosc-google/"
    structuredData={structuredData}
    active="widocznosc"
>
    <section class="page-head" data-clip="Widoczność" data-track="t1">
        <p class="eyebrow">Google Maps · ChatGPT · Lubliniec i okolice</p>
        <h1 class="display">Niech Google i ChatGPT <span class="cut">polecają Ciebie.</span></h1>
        <p class="lead">
            Klienci coraz częściej nie przeglądają stron, tylko pytają: „dobry mechanik w Lublińcu?”.
            Odpowiedź dają Mapy Google i asystenci AI, a oni wskazują tylko kilka firm.
            Sprawdzę za darmo, czy jesteś wśród nich, i pokażę, co poprawić.
        </p>
        <div class="actions">
            <a href="#audyt" class="btn btn-primary">Darmowy audyt</a>
            <a href="#pakiety" class="btn btn-ghost">Zobacz pakiety</a>
        </div>
    </section>

    <section class="block" id="co-sprawdzam" data-clip="Audyt" data-track="v2">
        <div class="block-head reveal">
            <h2 class="h2">Co sprawdzam</h2>
            <p class="block-sub">Google i asystenci AI polecają firmy, o których mają pełne, spójne i świeże informacje. Sprawdzam każde z tych miejsc.</p>
        </div>
        <ol class="tracks">
            <li class="track track-t1 reveal">
                <span class="track-id">MAP</span>
                <div class="track-body">
                    <h3>Wizytówka w Mapach Google</h3>
                    <p>Kategorie, usługi, godziny, opis, zdjęcia i posty. Najczęściej brakuje tu rzeczy, które da się poprawić w jeden dzień.</p>
                </div>
                <span class="track-lane" aria-hidden="true"><i style="--l:0;--w:24"></i><i style="--l:28;--w:14"></i><i style="--l:46;--w:30"></i><i style="--l:80;--w:14"></i></span>
            </li>
            <li class="track track-v1 reveal">
                <span class="track-id">AI</span>
                <div class="track-body">
                    <h3>ChatGPT, Gemini, Perplexity</h3>
                    <p>Zadaję asystentom pytania, które zadają Twoi klienci, i sprawdzam, kogo polecają, a kogo pomijają.</p>
                </div>
                <span class="track-lane" aria-hidden="true"><i style="--l:6;--w:10"></i><i style="--l:22;--w:18"></i><i style="--l:46;--w:8"></i><i style="--l:60;--w:22"></i></span>
            </li>
            <li class="track track-v2 reveal">
                <span class="track-id">NAP</span>
                <div class="track-body">
                    <h3>Spójne dane firmy</h3>
                    <p>Nazwa, adres i telefon w Bing, Apple Maps, na Facebooku i w katalogach firm. Rozbieżności mylą Google i AI.</p>
                </div>
                <span class="track-lane" aria-hidden="true"><i style="--l:4;--w:8"></i><i style="--l:16;--w:12"></i><i style="--l:32;--w:8"></i><i style="--l:46;--w:14"></i><i style="--l:66;--w:10"></i><i style="--l:82;--w:12"></i></span>
            </li>
            <li class="track track-a1 reveal">
                <span class="track-id">OPN</span>
                <div class="track-body">
                    <h3>Opinie</h3>
                    <p>Liczba, średnia, świeżość i odpowiedzi właściciela. Na tym AI w dużej mierze opiera polecenia.</p>
                </div>
                <span class="track-lane track-wave" aria-hidden="true"></span>
            </li>
            <li class="track track-c reveal">
                <span class="track-id">KON</span>
                <div class="track-body">
                    <h3>Konkurencja</h3>
                    <p>Porównanie z trzema firmami, które Google pokazuje nad Tobą: opinie, zdjęcia, aktywność.</p>
                </div>
                <span class="track-lane track-grade" aria-hidden="true"></span>
            </li>
        </ol>
    </section>

    <section class="block" id="pakiety" data-clip="Pakiety" data-track="a1">
        <div class="block-head reveal">
            <h2 class="h2">Pakiety</h2>
            <p class="block-sub">Zaczynamy od darmowego audytu. Dopiero gdy zobaczysz, co jest do poprawy, decydujesz, czy chcesz iść dalej.</p>
        </div>
        <div class="plans">
            {plans.map(p => (
                <article class={`plan track-${p.track} reveal`}>
                    <span class="plan-id">{p.id}</span>
                    <h3>{p.name}</h3>
                    <p class="plan-price">{p.price} <span>{p.unit}</span></p>
                    <ul>
                        {p.items.map(item => <li>{item}</li>)}
                    </ul>
                    <a href="#audyt" class={p.id === 'AUD' ? 'btn btn-primary' : 'btn btn-ghost'}>{p.cta}</a>
                </article>
            ))}
        </div>
        <p class="plans-note reveal">
            <strong>Wizytówka + rolki:</strong> do stałej opieki mogę dołożyć krótkie rolki. Te same filmy trafiają do wizytówki w Google i na Instagrama.
            Ceny zależą od branży i stanu profilu, dokładną kwotę podaję po audycie.
        </p>
    </section>

    <section class="block" id="proces-widocznosc" data-clip="Proces" data-track="t1">
        <div class="block-head reveal">
            <h2 class="h2">Jak to wygląda</h2>
            <p class="block-sub">Od zgłoszenia do firmy, którą klienci znajdują.</p>
        </div>
        <ol class="steps">
            <li class="step reveal">
                <span class="step-tc">00:00</span>
                <h3>Zgłaszasz firmę</h3>
                <p>Wypełniasz krótki formularz poniżej. Wystarczy nazwa firmy i miasto.</p>
            </li>
            <li class="step reveal">
                <span class="step-tc">00:05</span>
                <h3>Dostajesz audyt</h3>
                <p>W ciągu 2 dni roboczych wysyłam jedną stronę: co jest źle, jak wypadasz na tle konkurencji i co mówią o Tobie AI.</p>
            </li>
            <li class="step reveal">
                <span class="step-tc">00:15</span>
                <h3>Wdrożenie</h3>
                <p>Jeśli chcesz, poprawiam wszystko za Ciebie. Dodajesz mnie jako menedżera profilu, hasła zostają u Ciebie.</p>
            </li>
            <li class="step reveal">
                <span class="step-tc">00:40</span>
                <h3>Opieka i raport</h3>
                <p>Profil żyje: posty, zdjęcia, odpowiedzi na opinie. Co miesiąc dostajesz raport z wynikami.</p>
            </li>
        </ol>
    </section>

    <section class="block" id="audyt" data-clip="Darmowy audyt" data-track="v1">
        <div class="block-head reveal">
            <h2 class="h2">Darmowy audyt</h2>
            <p class="block-sub">Podaj nazwę firmy i miasto. Resztę sprawdzę sam i odezwę się z wynikami.</p>
        </div>
        <div class="contact contact-inline">
            <form class="form audit-form" action="https://formspree.io/f/mbdrgppo" method="POST">
                <input type="hidden" name="_subject" value="Darmowy audyt widoczności (jankobus.com)">
                <input type="hidden" name="temat" value="audyt-widocznosci">
                <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
                <div class="field-row">
                    <div class="field">
                        <label for="a-company">Nazwa firmy</label>
                        <input type="text" id="a-company" name="firma" autocomplete="organization" required>
                    </div>
                    <div class="field">
                        <label for="a-city">Miasto</label>
                        <input type="text" id="a-city" name="miasto" autocomplete="address-level2" placeholder="np. Lubliniec" required>
                    </div>
                </div>
                <div class="field-row">
                    <div class="field">
                        <label for="a-name">Imię</label>
                        <input type="text" id="a-name" name="name" autocomplete="name" required>
                    </div>
                    <div class="field">
                        <label for="a-email">Email</label>
                        <input type="email" id="a-email" name="email" autocomplete="email" required>
                    </div>
                </div>
                <div class="field-row">
                    <div class="field">
                        <label for="a-industry">Branża <small>(opcjonalnie)</small></label>
                        <input type="text" id="a-industry" name="branza" placeholder="np. warsztat, fryzjer, restauracja">
                    </div>
                    <div class="field">
                        <label for="a-phone">Telefon <small>(opcjonalnie)</small></label>
                        <input type="tel" id="a-phone" name="telefon" autocomplete="tel">
                    </div>
                </div>
                <div class="field">
                    <label for="a-link">Link do wizytówki Google albo strony <small>(opcjonalnie)</small></label>
                    <input type="url" id="a-link" name="link" placeholder="https://">
                </div>
                <div class="field">
                    <label for="a-message">Co chcesz poprawić? <small>(opcjonalnie)</small></label>
                    <textarea id="a-message" name="message" placeholder="np. mało telefonów z Google, konkurencja jest wyżej w Mapach"></textarea>
                </div>
                <label class="check">
                    <input type="checkbox" name="zgoda" value="tak" required>
                    <span>Zgadzam się na kontakt mailowy lub telefoniczny w sprawie audytu i oferty usług Jana Kobusa. Zgodę mogę wycofać w każdej chwili.</span>
                </label>
                <div>
                    <button type="submit" class="btn btn-primary">Wyślij zgłoszenie</button>
                </div>
                <p class="form-status" role="status" aria-live="polite" hidden></p>
                <p class="form-note">
                    Administratorem danych jest Jan Kobus, Lubliniec. Dane służą wyłącznie do przygotowania audytu i kontaktu w tej sprawie.
                    Formularz obsługuje Formspree.
                </p>
            </form>

            <aside class="aside">
                <h2>Co dostaniesz</h2>
                <ul>
                    <li>Zrzut ekranu: kogo Google pokazuje w Mapach na Twoje hasła.</li>
                    <li>Odpowiedzi ChatGPT, Gemini i Perplexity na pytanie o Twoją branżę w Twoim mieście.</li>
                    <li>Porównanie z trzema konkurentami.</li>
                    <li>Listę poprawek od najważniejszej.</li>
                </ul>
                <p>Bez zobowiązań. Możesz wdrożyć poprawki sam.</p>
                <p>Wolisz zadzwonić? <a class="phone" href="tel:+48732800250">732 800 250</a></p>
            </aside>
        </div>
    </section>

    <section class="block" id="faq-widocznosc" data-clip="FAQ" data-track="v2">
        <div class="block-head reveal">
            <h2 class="h2">Pytania</h2>
        </div>
        <div class="faq">
            {faq.map(({ q, a }) => (
                <details class="faq-item reveal">
                    <summary>{q}</summary>
                    <p>{a}</p>
                </details>
            ))}
        </div>
    </section>

    <section class="end" data-clip="Kontakt" data-track="v1">
        <h2 class="display display-end">Sprawdź, czy Cię widać.</h2>
        <p class="lead">Audyt jest darmowy i do niczego nie zobowiązuje. Możesz też zadzwonić: <a class="phone" href="tel:+48732800250">732 800 250</a></p>
        <a href="#audyt" class="btn btn-primary">Zamów darmowy audyt</a>
    </section>

    <script is:inline>
    (() => {
      // Wysyłka bez przeładowania; bez JS formularz działa zwykłym POST-em do Formspree
      const form = document.querySelector('.audit-form');
      if (!form) return;
      const status = form.querySelector('.form-status');
      const btn = form.querySelector('button[type="submit"]');
      const subject = form.querySelector('input[name="_subject"]');
      const show = (text, ok) => { status.hidden = false; status.textContent = text; status.classList.toggle('ok', ok); };

      form.addEventListener('submit', async e => {
        e.preventDefault();
        subject.value = 'Darmowy audyt: ' + form.firma.value + ' (' + form.miasto.value + ')';
        btn.disabled = true;
        btn.textContent = 'Wysyłam…';
        try {
          const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error(res.status);
          form.reset();
          show('Dzięki! Zgłoszenie dotarło. Audyt wyślę mailem w ciągu 2 dni roboczych.', true);
        } catch {
          show('Nie udało się wysłać. Spróbuj ponownie albo zadzwoń: 732 800 250.', false);
        } finally {
          btn.disabled = false;
          btn.textContent = 'Wyślij zgłoszenie';
        }
      });
    })();
    </script>
</ReelLayout>
