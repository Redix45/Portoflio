---
import type { Site } from '../data/sites';

interface Props {
  site: Site;
}

const { site } = Astro.props;
---

<article class="site reveal">
    <a class="site-link" href={site.url} target="_blank" rel="noopener">
        <div class="site-frame">
            <div class="site-bar" aria-hidden="true"><i></i><i></i><i></i><span>{site.name}</span></div>
            <picture>
                <source srcset={`${site.img}.webp`} type="image/webp">
                <img src={`${site.img}.jpg`} alt={`Strona ${site.name}`} width="1200" height="750" loading="lazy" decoding="async">
            </picture>
        </div>
    </a>
    <div class="site-info">
        <span class="reel-tag">{site.tag}</span>
        <h3><a href={site.url} target="_blank" rel="noopener">{site.name} <span aria-hidden="true">↗</span></a></h3>
        <p>{site.text}</p>
        {site.stats && (
            <dl class="site-stats">
                {site.stats.map(s => (
                    <div>
                        <dt>{s.label}</dt>
                        <dd>{s.value}</dd>
                    </div>
                ))}
            </dl>
        )}
        {site.statsNote && <p class="site-note">{site.statsNote}</p>}
    </div>
</article>
