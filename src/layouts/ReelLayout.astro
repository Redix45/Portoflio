---
// Wspólny layout strony: nagłówek, stopka i oś czasu na dole ekranu.
// CSS importowany tutaj dostaje od Astro nazwę z hashem, więc przeglądarki nie trzymają starej wersji.
import '../styles/rolki.css';
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  structuredData?: any;
  active?: 'home' | 'o-mnie' | 'kontakt';
}

const {
  title,
  description = '',
  canonical = '',
  ogType = 'website',
  ogImage = 'https://jankobus.com/favicon.jpg',
  structuredData = null,
  active = 'home'
} = Astro.props;

const currentUrl = canonical || `https://jankobus.com${Astro.url.pathname}`;
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="author" content="Jan Kobus">
    <meta name="robots" content="index, follow">
    <meta name="theme-color" content="#141519">
    <link rel="canonical" href={currentUrl}>

    <meta property="og:type" content={ogType}>
    <meta property="og:url" content={currentUrl}>
    <meta property="og:title" content={title}>
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage}>
    <meta property="og:locale" content="pl_PL">
    <meta property="og:site_name" content="Jan Kobus – montaż rolek">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content={title}>
    {description && <meta name="twitter:description" content={description} />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" type="image/x-icon">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,500..900&family=Figtree:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
    <a class="skip-link" href="#tresc">Przejdź do treści</a>

    <header class="topbar">
        <a href="/" class="brand" aria-label="Jan Kobus – strona główna">
            <span class="brand-name">Jan Kobus</span>
            <span class="brand-role">montaż rolek</span>
        </a>
        <nav class="menu" aria-label="Główna nawigacja">
            <a href="/#realizacje">Realizacje</a>
            <a href="/#uslugi">Usługi</a>
            <a href="/#proces">Jak pracuję</a>
            <a href="/o-mnie/" aria-current={active === 'o-mnie' ? 'page' : undefined}>O mnie</a>
            <a href="/kontakt/" class="menu-cta" aria-current={active === 'kontakt' ? 'page' : undefined}>Wyślij materiał</a>
        </nav>
        <button class="menu-toggle" aria-label="Otwórz menu" aria-expanded="false">
            <span></span><span></span>
        </button>
    </header>

    <main id="tresc">
        <slot />
    </main>

    <footer class="footer" data-clip="Napisy końcowe" data-track="t1">
        <div class="footer-row">
            <div>
                <p class="footer-name">Jan Kobus</p>
                <p class="footer-meta">Montaż rolek · zdalnie w całej Polsce</p>
            </div>
            <div class="footer-links">
                <a href="https://www.instagram.com/redix.45/" target="_blank" rel="noopener noreferrer">Instagram</a>
                <a href="https://www.facebook.com/profile.php?id=61587671346611" target="_blank" rel="noopener noreferrer">Facebook</a>
                <a href="/kontakt/">Kontakt</a>
            </div>
        </div>
        <p class="footer-small">&copy; {year} Jan Kobus</p>
    </footer>

    <!-- Oś czasu: cała strona to sekwencja 45 s, playhead = pozycja scrolla -->
    <div class="seq" aria-hidden="true">
        <div class="seq-area">
            <div class="seq-lane"></div>
            <div class="seq-playhead"></div>
        </div>
        <span class="seq-tc">00:00:00:00</span>
    </div>

    <script is:inline>
    (() => {
      const FPS = 30, SEQ_SECONDS = 45;
      const pad = n => String(n).padStart(2, '0');
      const tc = frames => {
        const f = frames % FPS, s = Math.floor(frames / FPS);
        return `00:${pad(Math.floor(s / 60))}:${pad(s % 60)}:${pad(f)}`;
      };
      window.__tc = tc;

      // Menu mobilne
      const toggle = document.querySelector('.menu-toggle');
      const menu = document.querySelector('.menu');
      toggle?.addEventListener('click', () => {
        const open = menu.classList.toggle('open');
        toggle.setAttribute('aria-expanded', open);
        toggle.setAttribute('aria-label', open ? 'Zamknij menu' : 'Otwórz menu');
      });
      menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
        menu.classList.remove('open');
        toggle?.setAttribute('aria-expanded', 'false');
      }));

      // Sekwencja: cała strona = 45 s, klipy = sekcje z data-clip.
      // Klik albo przeciągnięcie na osi przewija stronę.
      const seq = document.querySelector('.seq');
      const area = seq.querySelector('.seq-area');
      const lane = seq.querySelector('.seq-lane');
      const tcEl = seq.querySelector('.seq-tc');
      const sections = [...document.querySelectorAll('[data-clip]')];
      const doc = document.documentElement;
      let clips = [];

      // 0 na górze strony, 1 na dole; gdy sekcja dochodzi do góry ekranu,
      // playhead stoi na początku jej klipu.
      const progress = () => {
        const max = doc.scrollHeight - innerHeight;
        if (max <= 0) return 0;
        const y = scrollY + innerHeight * (scrollY / max);
        return Math.min(1, Math.max(0, y / doc.scrollHeight));
      };
      const scrollToProgress = p => {
        const max = doc.scrollHeight - innerHeight;
        scrollTo({ top: p * doc.scrollHeight / (1 + innerHeight / max), behavior: 'instant' });
      };

      const layoutClips = () => {
        const total = doc.scrollHeight;
        lane.replaceChildren();
        clips = sections.map(sec => {
          const start = sec.offsetTop / total, len = sec.offsetHeight / total;
          const clip = document.createElement('div');
          clip.className = 'seq-clip track-' + (sec.dataset.track || 'v1');
          clip.style.left = (start * 100) + '%';
          clip.style.width = (len * 100) + '%';
          clip.textContent = sec.dataset.clip;
          lane.appendChild(clip);
          return { el: clip, start, end: start + len };
        });
      };

      const update = () => {
        const p = progress();
        seq.style.setProperty('--p', p);
        tcEl.textContent = tc(Math.round(p * SEQ_SECONDS * FPS));
        clips.forEach(c => c.el.classList.toggle('active', p >= c.start && p < c.end));
      };

      let dragging = false;
      const scrubAt = x => {
        const r = area.getBoundingClientRect();
        scrollToProgress(Math.min(1, Math.max(0, (x - r.left) / r.width)));
      };
      area.addEventListener('pointerdown', e => { dragging = true; area.setPointerCapture(e.pointerId); scrubAt(e.clientX); });
      area.addEventListener('pointermove', e => { if (dragging) scrubAt(e.clientX); });
      area.addEventListener('pointerup', () => { dragging = false; });
      area.addEventListener('pointercancel', () => { dragging = false; });

      const relayout = () => { layoutClips(); update(); };
      relayout();
      addEventListener('resize', relayout);
      addEventListener('load', relayout);
      document.fonts?.ready.then(relayout);
      addEventListener('scroll', update, { passive: true });

      // Wejście sekcji
      const io = new IntersectionObserver(entries => entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }), { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach(el => io.observe(el));
    })();
    </script>
</body>
</html>
