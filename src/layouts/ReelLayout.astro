---
// Wspólny layout strony: nagłówek, stopka i oś czasu na dole ekranu.
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  structuredData?: any;
  active?: 'home' | 'o-mnie' | 'kontakt';
}

const {
  title,
  description = '',
  canonical = '',
  ogType = 'website',
  ogImage = 'https://jankobus.com/favicon.jpg',
  structuredData = null,
  active = 'home'
} = Astro.props;

const currentUrl = canonical || `https://jankobus.com${Astro.url.pathname}`;
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="author" content="Jan Kobus">
    <meta name="robots" content="index, follow">
    <meta name="theme-color" content="#141519">
    <link rel="canonical" href={currentUrl}>

    <meta property="og:type" content={ogType}>
    <meta property="og:url" content={currentUrl}>
    <meta property="og:title" content={title}>
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage}>
    <meta property="og:locale" content="pl_PL">
    <meta property="og:site_name" content="Jan Kobus – montaż rolek">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content={title}>
    {description && <meta name="twitter:description" content={description} />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" type="image/x-icon">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,500..900&family=Figtree:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/rolki.css">
</head>
<body>
    <a class="skip-link" href="#tresc">Przejdź do treści</a>

    <header class="topbar">
        <a href="/" class="brand" aria-label="Jan Kobus – strona główna">
            <span class="brand-name">Jan Kobus</span>
            <span class="brand-role">montaż rolek</span>
        </a>
        <nav class="menu" aria-label="Główna nawigacja">
            <a href="/#realizacje">Realizacje</a>
            <a href="/#uslugi">Usługi</a>
            <a href="/#proces">Jak pracuję</a>
            <a href="/o-mnie/" aria-current={active === 'o-mnie' ? 'page' : undefined}>O mnie</a>
            <a href="/kontakt/" class="menu-cta" aria-current={active === 'kontakt' ? 'page' : undefined}>Wyślij materiał</a>
        </nav>
        <button class="menu-toggle" aria-label="Otwórz menu" aria-expanded="false">
            <span></span><span></span>
        </button>
    </header>

    <main id="tresc">
        <slot />
    </main>

    <footer class="footer" data-clip="Napisy końcowe" data-track="t1">
        <div class="footer-row">
            <div>
                <p class="footer-name">Jan Kobus</p>
                <p class="footer-meta">Montaż rolek · zdalnie w całej Polsce</p>
            </div>
            <div class="footer-links">
                <a href="https://www.instagram.com/redix.45/" target="_blank" rel="noopener noreferrer">Instagram</a>
                <a href="https://www.facebook.com/profile.php?id=61587671346611" target="_blank" rel="noopener noreferrer">Facebook</a>
                <a href="/kontakt/">Kontakt</a>
            </div>
        </div>
        <p class="footer-small">&copy; {year} Jan Kobus</p>
    </footer>

    <!-- Oś czasu: cała strona to sekwencja 45 s, playhead = pozycja scrolla -->
    <div class="seq" aria-hidden="true">
        <div class="seq-heads">
            <span class="seq-head-ruler">SEQ</span>
            <span class="seq-head seq-head-v">V1</span>
            <span class="seq-head seq-head-a">A1</span>
        </div>
        <div class="seq-area">
            <div class="seq-ruler"></div>
            <div class="seq-lane seq-v"></div>
            <div class="seq-lane seq-a">
                <canvas class="wave wave-dim"></canvas>
                <canvas class="wave wave-lit"></canvas>
            </div>
            <div class="seq-playhead"><span class="seq-grip"></span></div>
        </div>
        <div class="seq-readout">
            <span class="seq-tc">00:00:00:00</span>
            <span class="seq-now">Hook</span>
        </div>
    </div>

    <script is:inline>
    (() => {
      const FPS = 30, SEQ_SECONDS = 45;
      const pad = n => String(n).padStart(2, '0');
      const tc = frames => {
        const f = frames % FPS, s = Math.floor(frames / FPS);
        return `00:${pad(Math.floor(s / 60))}:${pad(s % 60)}:${pad(f)}`;
      };
      window.__tc = tc;

      // Menu mobilne
      const toggle = document.querySelector('.menu-toggle');
      const menu = document.querySelector('.menu');
      toggle?.addEventListener('click', () => {
        const open = menu.classList.toggle('open');
        toggle.setAttribute('aria-expanded', open);
        toggle.setAttribute('aria-label', open ? 'Zamknij menu' : 'Otwórz menu');
      });
      menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
        menu.classList.remove('open');
        toggle?.setAttribute('aria-expanded', 'false');
      }));

      // Sekwencja: cała strona = 45 s. Klipy na V1 = sekcje z data-clip,
      // A1 = waveform. Playhead można chwycić i przewijać nim stronę.
      const seq = document.querySelector('.seq');
      const area = seq.querySelector('.seq-area');
      const ruler = seq.querySelector('.seq-ruler');
      const laneV = seq.querySelector('.seq-v');
      const tcEl = seq.querySelector('.seq-tc');
      const nowEl = seq.querySelector('.seq-now');
      const [waveDim, waveLit] = seq.querySelectorAll('.wave');
      const sections = [...document.querySelectorAll('[data-clip]')];
      const doc = document.documentElement;
      let clips = [];

      // Pozycja "czytania": 0 na górze strony, 1 na samym dole.
      // Gdy sekcja dochodzi do góry ekranu, playhead stoi na początku jej klipu.
      const progress = () => {
        const max = doc.scrollHeight - innerHeight;
        if (max <= 0) return 0;
        const y = scrollY + innerHeight * (scrollY / max);
        return Math.min(1, Math.max(0, y / doc.scrollHeight));
      };
      const scrollToProgress = p => {
        const max = doc.scrollHeight - innerHeight;
        const y = p * doc.scrollHeight / (1 + innerHeight / max);
        scrollTo({ top: y, behavior: 'instant' });
      };

      const secLabel = s => `${String(Math.floor(s)).padStart(2, '0')}s`;

      const layoutRuler = () => {
        ruler.replaceChildren();
        for (let s = 0; s <= SEQ_SECONDS; s += 5) {
          const l = document.createElement('span');
          l.className = 'seq-mark';
          l.style.left = (s / SEQ_SECONDS * 100) + '%';
          l.textContent = s === 0 ? '00:00' : `00:${String(s).padStart(2, '0')}`;
          ruler.appendChild(l);
        }
      };

      const layoutClips = () => {
        const total = doc.scrollHeight;
        laneV.replaceChildren();
        ruler.querySelectorAll('.seq-marker').forEach(m => m.remove());
        clips = sections.map(sec => {
          const start = sec.offsetTop / total, len = sec.offsetHeight / total;
          const track = sec.dataset.track || 'v1';
          const clip = document.createElement('div');
          clip.className = 'seq-clip track-' + track;
          clip.style.left = (start * 100) + '%';
          clip.style.width = (len * 100) + '%';
          const name = document.createElement('span');
          name.className = 'seq-clip-name';
          name.textContent = sec.dataset.clip;
          const dur = document.createElement('span');
          dur.className = 'seq-clip-dur';
          dur.textContent = secLabel(len * SEQ_SECONDS);
          clip.append(name, dur);
          laneV.appendChild(clip);

          const marker = document.createElement('i');
          marker.className = 'seq-marker track-' + track;
          marker.style.left = (start * 100) + '%';
          ruler.appendChild(marker);
          return { el: clip, start, end: start + len, name: sec.dataset.clip };
        });
      };

      // Waveform: deterministyczny "utwór" z akcentami co beat
      const drawWave = () => {
        const w = waveDim.clientWidth, h = waveDim.clientHeight, dpr = devicePixelRatio || 1;
        if (!w || !h) return;
        const styles = getComputedStyle(seq);
        [[waveDim, styles.getPropertyValue('--wave-dim')], [waveLit, styles.getPropertyValue('--wave-lit')]].forEach(([cv, color]) => {
          cv.width = w * dpr; cv.height = h * dpr;
          const ctx = cv.getContext('2d');
          ctx.scale(dpr, dpr);
          ctx.fillStyle = color.trim();
          let seed = 7;
          const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
          const bar = 2, gap = 1, n = Math.floor(w / (bar + gap));
          for (let i = 0; i < n; i++) {
            const t = i / n;
            const beat = Math.pow(Math.abs(Math.cos(t * SEQ_SECONDS * 2 * Math.PI)), 6); // 120 BPM
            const env = 0.35 + 0.65 * Math.min(1, t * 8) * (t > 0.92 ? (1 - t) / 0.08 : 1);
            const a = Math.min(1, env * (0.25 + 0.45 * rnd() + 0.45 * beat));
            const bh = Math.max(1, a * h);
            ctx.fillRect(i * (bar + gap), (h - bh) / 2, bar, bh);
          }
        });
      };

      const update = () => {
        const p = progress();
        seq.style.setProperty('--p', p);
        tcEl.textContent = tc(Math.round(p * SEQ_SECONDS * FPS));
        let current = clips[0];
        clips.forEach(c => {
          const on = p >= c.start && p < c.end;
          c.el.classList.toggle('active', on);
          if (on) current = c;
        });
        if (current && nowEl.textContent !== current.name) nowEl.textContent = current.name;
      };

      // Scrubbing: klik albo przeciągnięcie na osi
      let dragging = false;
      const scrubAt = x => {
        const r = area.getBoundingClientRect();
        scrollToProgress(Math.min(1, Math.max(0, (x - r.left) / r.width)));
      };
      area.addEventListener('pointerdown', e => {
        dragging = true; seq.classList.add('scrubbing');
        area.setPointerCapture(e.pointerId); scrubAt(e.clientX);
      });
      area.addEventListener('pointermove', e => { if (dragging) scrubAt(e.clientX); });
      const stop = () => { dragging = false; seq.classList.remove('scrubbing'); };
      area.addEventListener('pointerup', stop);
      area.addEventListener('pointercancel', stop);

      const relayout = () => { layoutClips(); drawWave(); update(); };
      layoutRuler();
      relayout();
      addEventListener('resize', relayout);
      addEventListener('load', relayout);
      document.fonts?.ready.then(relayout);
      addEventListener('scroll', update, { passive: true });

      // Wejście sekcji
      const io = new IntersectionObserver(entries => entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }), { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach(el => io.observe(el));
    })();
    </script>
</body>
</html>
